{
  "name": "@active-book/core",
  "version": "0.0.63",
  "description": "",
  "main": "./lib/src/index.js",
  "type": "module",
  "scripts": {
    "make": "node ./scripts/make.js",
    "clean": "rimraf dist tgz lib lib-esm",
    "ts": "tsc -m es2020 --outDir lib",
    "copy-files": "copyfiles -u 1 -s -e \"src/**/*.ts\" -e \"src/**/*.tsx\" \"src/**/*.*\" lib/src/",
    "packaging": "node ./scripts/tgzPrepare.js && npm pack --pack-destination ./tgz",
    "up": "npm version patch --git-tag-version false --commit-hooks false",
    "scss": "npx sass src:src",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:scss-alias": "node --test ./scripts/scssAlias.test.js",
    "test:browser": "node ./scripts/runBrowserTests.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --project tests/tsconfig.json",
    "lint:ts": "eslint \"./src/**/*.{ts,tsx}\" --fix",
    "lint:css": "stylelint \"src/**/*.scss\" --fix",
    "lint-staged": "lint-staged",
    "postinstall": "node ./scripts/postinstall.js",
    "pre-commit": "lint-staged",
    "dev:visual-lab": "node scripts/visualPlayground.js",
    "test:visual-lab": "node --test scripts/visualPlayground.browser.test.js",
    "lint:ts:check": "eslint \"./src/**/*.{ts,tsx}\"",
    "lint:css:check": "stylelint \"src/**/*.scss\"",
    "test:unit": "jest --runInBand"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@lottiefiles/dotlottie-react": "^0.17.15",
    "@lottiefiles/dotlottie-web": "^0.58.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@reduxjs/toolkit": "^2.14.0",
    "classnames": "2.5.1",
    "cryptr": "^6.4.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "hammerjs": "^2.0.8",
    "howler": "^2.2.4",
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-fast-compare": "^3.2.2",
    "react-range": "^1.10.0",
    "react-redux": "^9.3.1",
    "react-style-stringify": "^1.2.0",
    "react-toastify": "^11.2.0",
    "redux-saga": "^1.5.1"
  },
  "peerDependencies": {
    "@active-book/types": "^0.0.3"
  },
  "devDependencies": {
    "@active-book/common": "file:../active-book-common",
    "@active-book/types": "file:../active-book-types",
    "@jest/types": "^30.5.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/hammerjs": "^2.0.46",
    "@types/howler": "^2.2.13",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-image-capture": "^1.0.11",
    "copyfiles": "^2.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-sonar-reporter": "^2.0.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "react-app-polyfill": "^3.0.0",
    "rimraf": "^6.1.4",
    "sass": "^1.108.1",
    "stylelint": "16.26.1",
    "tsc-alias": "^1.9.10",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrimsonKing1337/active-book-core.git"
  },
  "author": "Oleg Shilov Jr",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/KrimsonKing1337/active-book-core/issues"
  },
  "homepage": "https://github.com/KrimsonKing1337/active-book-core#readme",
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
