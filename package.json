{
  "name": "@active-book/core",
  "version": "0.0.64",
  "description": "",
  "type": "module",
  "scripts": {
    "make": "node ./scripts/make.js",
    "clean": "rimraf dist tgz lib lib-esm",
    "ts": "tsc --project tsconfig.build.json",
    "copy-files": "node ./scripts/copyRuntimeFiles.js",
    "packaging": "node ./scripts/tgzPrepare.js && npm pack --pack-destination ./tgz",
    "up": "npm version patch --git-tag-version false --commit-hooks false",
    "scss": "npx sass src:src",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:scss-alias": "node --test ./tests/scssAlias/scssAlias.test.js",
    "test:browser": "node ./scripts/runBrowserTests.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --project tests/tsconfig.json",
    "lint:ts": "eslint \"**/*.{ts,tsx,mts,cts}\" --fix",
    "lint:css": "stylelint \"{src,tests}/**/*.scss\" --fix",
    "lint-staged": "lint-staged",
    "pre-commit": "lint-staged",
    "dev:visual-lab": "node scripts/visualPlayground.js",
    "test:visual-lab": "node --test tests/visualPlayground/visualPlayground.browser.test.js",
    "lint:ts:check": "eslint \"**/*.{ts,tsx,mts,cts}\"",
    "lint:css:check": "stylelint \"{src,tests}/**/*.scss\"",
    "test:unit": "jest --runInBand",
    "test:scripts": "node --test tests/eslint/eslint.test.js tests/jest/file-transform.test.js tests/infrastructure/*.test.js tests/packaging/package.test.js",
    "build": "node ./scripts/build.js",
    "lint:js": "eslint \"**/*.{js,jsx,mjs,cjs}\" --fix",
    "lint:js:check": "eslint \"**/*.{js,jsx,mjs,cjs}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@lottiefiles/dotlottie-react": "^0.17.15",
    "@lottiefiles/dotlottie-web": "^0.58.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@types/howler": "^2.2.13",
    "classnames": "2.5.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "hammerjs": "^2.0.8",
    "howler": "^2.2.4",
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-range": "^1.10.0",
    "react-redux": "^9.3.1",
    "react-style-stringify": "^1.2.0",
    "react-toastify": "^11.2.0",
    "redux-saga": "^1.5.1"
  },
  "peerDependencies": {
    "@active-book/types": "^0.0.3"
  },
  "devDependencies": {
    "@active-book/common": "file:../active-book-common",
    "@active-book/types": "file:../active-book-types",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/hammerjs": "^2.0.46",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-image-capture": "^1.0.11",
    "eslint": "10.14.0",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-sonar-reporter": "^2.0.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "react-app-polyfill": "^3.0.0",
    "rimraf": "^6.1.4",
    "sass": "^1.108.1",
    "stylelint": "16.26.1",
    "tsc-alias": "^1.9.10",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0"
  },
  "repository": {
    "type": "git",
