{
  "$schema": "https://json.schemastore.org/tsconfig#",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "lib",
    "baseUrl": "./",
    "paths": {
      "@@": ["./src"],
      "@@/*": ["./src/*"],
      "@types": ["./src/@types.ts"],
      "@assets": ["./src/assets"],
      "@assets/*": ["./src/assets/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@controllers": ["./src/controllers"],
      "@controllers/*": ["./src/controllers/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@styles": ["./src/styles"],
      "@styles/*": ["./src/styles/*"],
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "d.ts",
    "src/**/*",
    "tests/jest/setup-tests.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "public",
    "jest",
    "lib",
    "lib-esm"
  ],
  "extends": "@active-book/common/tsconfig.library.json"
}
