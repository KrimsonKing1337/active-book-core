{
  "$schema": "https://json.schemastore.org/tsconfig#",
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "outDir": "lib",
    "baseUrl": "./",
    "paths": {
      "@@": [
        "./src"
      ],
      "@@/*": [
        "./src/*"
      ],
      "@types": [
        "./src/@types.ts"
      ],
      "@assets": [
        "./src/assets"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@components": [
        "./src/components"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@controllers/*": [
        "./src/controllers/*"
      ],
      "@pages": [
        "./src/pages"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@hooks": [
        "./src/hooks"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@utils": [
        "./src/utils"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@store": [
        "./src/store"
      ],
      "@store/*": [
        "./src/store/*"
      ],
      "@styles": [
        "./src/styles"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@controllers": [
        "./src/controllers"
      ]
    },
    "lib": [
      "es2015",
      "dom"
    ]
  },
  "include": [
    "d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "public",
    "jest",
    "lib",
    "lib-esm"
  ],
  "extends": "@active-book/common/tsconfig.library.json"
}
